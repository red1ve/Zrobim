// =============================================================================
// Зробим — схема БД v2: безопасная сделка + подписки мастеров
// Источник правды для базы — миграции EF Core (src/Zrobim.Api/Data/Migrations);
// читаемое SQL-описание тех же constraints — db/migrations/V001__safe_deal_schema.sql
// (exclusion constraints, частичные индексы, CHECK и триггеры в DBML не выражаются,
//  они перечислены в Note у таблиц).
//
// Денежные потоки (не смешиваются):
//   №1  MASTER → ЗРОБИМ            subscription_payments → master_subscriptions
//   №2  CLIENT → ЗРОБИМ → MASTER   bookings → payments (HELD) → payouts
//
// Сделка: заявка → мастер принял → клиент платит 100% → услуга → окно спора → мастеру.
// 30% цены — залог: при вине клиента уходит мастеру (мастер может простить).
// =============================================================================

Project zrobim {
  database_type: 'PostgreSQL'
  Note: 'Зробим — маркетплейс услуг с безопасной сделкой. Доход платформы — подписки мастеров BASIC / PLUS.'
}

// ----------------------------------------------------------------------------- enums

Enum user_role {
  CLIENT
  MASTER
  ADMIN
}

Enum verification_status {
  PENDING
  APPROVED
  REJECTED
}

Enum location_type {
  MASTER_PLACE
  CLIENT_PLACE
}

Enum booking_status {
  PENDING          [note: 'заявка отправлена, ждём ответа мастера; время держится за клиентом']
  AWAITING_PAYMENT [note: 'мастер принял заявку, ждём оплату 100%']
  CONFIRMED        [note: 'оплачено (payment HELD) — запись полностью подтверждена, открыт чат']
  COMPLETED        [note: 'мастер отметил выполнение → окно спора']
  CLIENT_NO_SHOW   [note: 'мастер отметил неявку клиента → окно спора, залог мастеру']
  CANCELLED
  DISPUTED         [note: 'клиент открыл спор']
}

Enum payment_status {
  PENDING            [note: 'корзина: клиент нажал «Оплатить», провайдер ещё не подтвердил']
  HELD               [note: 'деньги получены платформой и удерживаются']
  RELEASED           [note: 'вся сумма мастеру']
  REFUNDED           [note: 'вся сумма клиенту']
  PARTIALLY_REFUNDED [note: 'залог мастеру, остаток клиенту']
  FAILED             [note: 'не оплачено (отказ провайдера или истекла корзина)']
}

Enum deposit_outcome {
  KEPT_BY_MASTER     [note: 'мастер решил оставить залог']
  WAIVED_BY_MASTER   [note: 'мастер вошёл в положение и вернул залог']
  KEPT_AUTOMATICALLY [note: 'мастер не ответил за 24 ч — залог ему по умолчанию']
}

Enum payout_status {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

Enum dispute_reason {
  SERVICE_NOT_PROVIDED
  MASTER_NO_SHOW
  POOR_QUALITY
  OTHER
}

Enum dispute_status {
  OPEN
  RESOLVED
}

Enum dispute_resolution {
  RELEASE_TO_MASTER [note: 'всё мастеру']
  REFUND_TO_CLIENT  [note: 'всё клиенту']
  DEPOSIT_TO_MASTER [note: 'залог мастеру, остаток клиенту']
}

Enum subscription_plan_code {
  BASIC
  PLUS
}

Enum subscription_payment_status {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// ----------------------------------------------------------------------------- users / masters

Table users {
  id            uuid         [pk, default: `gen_random_uuid()`]
  email         varchar(255) [not null]
  phone         varchar(30)  [unique]
  password_hash varchar(255) [not null]
  role          user_role    [not null]
  first_name    varchar(100) [not null]
  last_name     varchar(100)
  avatar_url    varchar(500)
  is_active     boolean      [not null, default: true]
  created_at    timestamptz  [not null, default: `now()`]
  updated_at    timestamptz  [not null, default: `now()`]

  indexes {
    (`lower(email)`) [unique, name: 'users_email_lower_key']
  }
}

Table masters {
  id                  uuid                [pk, default: `gen_random_uuid()`]
  user_id             uuid                [not null, unique, ref: - users.id]
  description         text
  city                varchar(100)
  address             text
  show_address_in_catalog boolean [not null, default: false, note: 'Мастер разрешил показывать адрес для услуг у мастера']
  latitude            decimal(10,7)
  longitude           decimal(10,7)
  verification_status verification_status [not null, default: 'PENDING']
  rating              decimal(3,2)        [not null, default: 0, note: 'кэш, пересчитывается при отзыве']
  reviews_count       int                 [not null, default: 0]
  payout_account      varchar(255)        [note: 'IBAN или токен провайдера. Номер карты хранить нельзя']
  created_at          timestamptz         [not null, default: `now()`]
  updated_at          timestamptz         [not null, default: `now()`]

  indexes {
    verification_status
    city
  }

  Note: '''
  CHECK: rating 0..5; reviews_count >= 0; latitude/longitude заданы вместе и в допустимых диапазонах;
  payout_account не пустой и не похож на номер карты (12+ цифр подряд).
  '''
}

// ----------------------------------------------------------------------------- catalog

Table categories {
  id         uuid         [pk, default: `gen_random_uuid()`]
  name       varchar(100) [not null, unique]
  image_url  varchar(500)
  is_active  boolean      [not null, default: true]
  created_at timestamptz  [not null, default: `now()`]
  updated_at timestamptz  [not null, default: `now()`]
}

Table services {
  id               uuid          [pk, default: `gen_random_uuid()`]
  master_id        uuid          [not null, ref: > masters.id]
  category_id      uuid          [not null, ref: > categories.id]
  name             varchar(150)  [not null]
  description      text
  price            decimal(12,2) [not null]
  duration_minutes int           [not null]
  location_type    location_type [not null]
  is_active        boolean       [not null, default: true]
  created_at       timestamptz   [not null, default: `now()`]
  updated_at       timestamptz   [not null, default: `now()`]

  indexes {
    (id, master_id) [unique, name: 'services_id_master_key', note: 'цель составного FK из bookings']
    master_id
    category_id [note: 'частичный: WHERE is_active']
  }

  Note: 'CHECK: price > 0; duration_minutes 1..1440.'
}

// ----------------------------------------------------------------------------- schedule

Table master_working_hours {
  id          uuid [pk, default: `gen_random_uuid()`]
  master_id   uuid [not null, ref: > masters.id]
  day_of_week int  [not null, note: '1 = понедельник … 7 = воскресенье; нет строки = выходной']
  start_time  time [not null]
  end_time    time [not null]

  indexes {
    (master_id, day_of_week) [unique]
  }

  Note: 'CHECK: day_of_week 1..7; end_time > start_time.'
}

Table master_time_blocks {
  id        uuid         [pk, default: `gen_random_uuid()`]
  master_id uuid         [not null, ref: > masters.id]
  start_at  timestamptz  [not null]
  end_at    timestamptz  [not null]
  reason    varchar(255)

  indexes {
    (master_id, start_at)
  }

  Note: 'CHECK: end_at > start_at.'
}

// ----------------------------------------------------------------------------- bookings (состояние услуги)

Table bookings {
  id                  uuid           [pk, default: `gen_random_uuid()`]
  client_id           uuid           [not null, ref: > users.id]
  master_id           uuid           [not null, ref: > masters.id]
  service_id          uuid           [not null, note: 'составной FK (service_id, master_id) → services']
  start_at            timestamptz    [not null]
  end_at              timestamptz    [not null, note: 'сервер: start_at + duration']
  price               decimal(12,2)  [not null, note: 'snapshot services.price']
  deposit_amount      decimal(12,2)  [not null, note: 'залог: snapshot 30% цены на момент заявки']
  location_type       location_type  [not null]
  address             text           [note: 'обязателен при CLIENT_PLACE']
  status              booking_status [not null, default: 'PENDING']
  client_comment      text
  response_deadline_at timestamptz   [not null, note: 'до когда мастер должен ответить: 12 ч, но ≤ start − 2 ч']
  accepted_at         timestamptz    [note: 'мастер принял заявку']
  payment_deadline_at timestamptz    [note: 'до когда бронь держится за клиентом без оплаты']
  deposit_outcome     deposit_outcome [note: 'только при вине клиента: поздняя отмена / неявка']
  cancelled_by        uuid           [ref: > users.id, note: 'NULL = отмена системой (таймаут)']
  cancellation_reason text
  cancelled_at        timestamptz
  completed_at        timestamptz
  created_at          timestamptz    [not null, default: `now()`]
  updated_at          timestamptz    [not null, default: `now()`]

  indexes {
    (id, client_id, master_id) [unique, name: 'bookings_id_client_master_key', note: 'цель составного FK из reviews']
    (client_id, start_at)
    (master_id, start_at)
    response_deadline_at [note: 'частичный: WHERE status = PENDING — для фоновой задачи']
    payment_deadline_at [note: 'частичный: WHERE status = AWAITING_PAYMENT — для фоновой задачи']
    end_at [note: 'частичный: WHERE status = CONFIRMED — «никто ничего не отметил»']
  }

  Note: '''
  EXCLUDE bookings_no_overlap USING gist (master_id WITH =, tstzrange(start_at, end_at) WITH &&)
    WHERE status IN (PENDING, AWAITING_PAYMENT, CONFIRMED)  → конфликт = 409 Conflict.
    Время держится за тем, кто первым подал заявку.
  CHECK: end_at > start_at; price > 0; 0 < deposit_amount <= price; response_deadline_at <= start_at;
         CLIENT_PLACE ⇒ address не пустой;
         accepted_at задан ⇔ payment_deadline_at задан; после PENDING (кроме CANCELLED) accepted_at обязателен;
         deposit_outcome только при CANCELLED / CLIENT_NO_SHOW / DISPUTED;
         status = CANCELLED ⇔ cancelled_at задан; cancelled_by только при CANCELLED;
         COMPLETED ⇒ completed_at задан.
  '''
}

Ref bookings_service_master_fk: bookings.(service_id, master_id) > services.(id, master_id)

// ----------------------------------------------------------------------------- payments (поток №2: CLIENT → ЗРОБИМ)

Table payments {
  id                  uuid           [pk, default: `gen_random_uuid()`, note: 'передаётся провайдеру как order id / idempotency key']
  booking_id          uuid           [not null, ref: > bookings.id]
  amount              decimal(12,2)  [not null, note: 'snapshot bookings.price, никогда из запроса клиента']
  currency            char(3)        [not null, default: 'BYN']
  status              payment_status [not null, default: 'PENDING']
  provider            varchar(50)    [not null]
  external_payment_id varchar(255)
  expires_at          timestamptz    [not null, note: 'корзина: 20 минут с момента нажатия «Оплатить»']
  release_after       timestamptz    [note: 'таймер распределения: после COMPLETED — всё мастеру, после вины клиента — залог мастеру; NULL = не запланирован']
  released_amount     decimal(12,2)  [not null, default: 0, note: 'сколько ушло мастеру']
  refunded_amount     decimal(12,2)  [not null, default: 0, note: 'сколько вернулось клиенту']
  failure_reason      text
  paid_at             timestamptz    [note: 'деньги получены и удерживаются']
  released_at         timestamptz
  refunded_at         timestamptz
  created_at          timestamptz    [not null, default: `now()`]
  updated_at          timestamptz    [not null, default: `now()`]

  indexes {
    (provider, external_payment_id) [unique]
    booking_id [name: 'payments_one_alive_per_booking', note: 'в миграции: UNIQUE + частичный WHERE status <> FAILED (DBML не умеет)']
    release_after [name: 'payments_auto_release_idx', note: 'частичный: WHERE status = HELD AND release_after IS NOT NULL']
    expires_at [note: 'частичный: WHERE status = PENDING — истёкшие корзины']
  }

  Note: '''
  client_id / master_id не хранятся: payment → booking → client / master.
  Несколько попыток оплаты после FAILED, но не более одного платежа со status <> FAILED на запись.
  CHECK: amount > 0; currency ~ ^[A-Z]{3}$; expires_at > created_at;
         status IN (HELD, RELEASED, REFUNDED, PARTIALLY_REFUNDED) ⇔ paid_at задан;
         RELEASED / PARTIALLY_REFUNDED ⇔ released_at; REFUNDED / PARTIALLY_REFUNDED ⇔ refunded_at;
         суммы: PENDING/HELD/FAILED — 0 и 0; RELEASED — всё мастеру; REFUNDED — всё клиенту;
                PARTIALLY_REFUNDED — обе части > 0 и в сумме = amount;
         release_after только при HELD / RELEASED / PARTIALLY_REFUNDED.
  Статус меняет только PaymentService по webhook / ответу провайдера, никогда мобильное приложение.
  '''
}

// ----------------------------------------------------------------------------- disputes

Table disputes {
  id                 uuid               [pk, default: `gen_random_uuid()`]
  booking_id         uuid               [not null, unique, ref: - bookings.id]
  opened_by          uuid               [not null, ref: > users.id]
  reason             dispute_reason     [not null]
  description        text
  status             dispute_status     [not null, default: 'OPEN']
  resolution         dispute_resolution
  resolved_by        uuid               [ref: > users.id]
  resolution_comment text
  created_at         timestamptz        [not null, default: `now()`]
  resolved_at        timestamptz

  indexes {
    created_at [note: 'частичный: WHERE status = OPEN — очередь админа']
  }

  Note: '''
  Пока спор OPEN, payment остаётся HELD, release_after = NULL.
  CHECK: OPEN ⇒ resolution, resolved_by, resolved_at пусты; RESOLVED ⇒ все три заданы.
  '''
}

// ----------------------------------------------------------------------------- payouts (поток №2: ЗРОБИМ → MASTER)

Table payouts {
  id                 uuid          [pk, default: `gen_random_uuid()`]
  payment_id         uuid          [not null, unique, ref: - payments.id]
  amount             decimal(12,2) [not null]
  currency           char(3)       [not null, default: 'BYN']
  status             payout_status [not null, default: 'PENDING']
  provider           varchar(50)   [not null]
  external_payout_id varchar(255)
  destination        varchar(255)  [not null, note: 'snapshot masters.payout_account']
  failure_reason     text
  completed_at       timestamptz
  created_at         timestamptz   [not null, default: `now()`]
  updated_at         timestamptz   [not null, default: `now()`]

  indexes {
    (provider, external_payout_id) [unique]
    status [note: 'частичный: WHERE status IN (PENDING, PROCESSING, FAILED)']
  }

  Note: '''
  master_id не хранится: payout → payment → booking → master.
  Создаётся только в транзакции HELD → RELEASED (всё) или HELD → PARTIALLY_REFUNDED (залог).
  UNIQUE(payment_id) запрещает двойную выплату.
  TRIGGER payouts_require_released_payment: payment.status IN (RELEASED, PARTIALLY_REFUNDED),
    amount = payment.released_amount, currency = payment.currency.
  CHECK: amount > 0; COMPLETED ⇔ completed_at; destination не пустой и не номер карты.
  '''
}

// ----------------------------------------------------------------------------- reviews / favorites / notifications

Table reviews {
  id         uuid        [pk, default: `gen_random_uuid()`]
  booking_id uuid        [not null, unique]
  client_id  uuid        [not null, ref: > users.id]
  master_id  uuid        [not null, ref: > masters.id]
  rating     int         [not null]
  text       text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (master_id, created_at)
  }

  Note: 'Составной FK (booking_id, client_id, master_id) → bookings: участники отзыва = участники записи. CHECK: rating 1..5.'
}

Ref reviews_booking_participants_fk: reviews.(booking_id, client_id, master_id) - bookings.(id, client_id, master_id)

Table favorites {
  client_id  uuid        [not null, ref: > users.id]
  master_id  uuid        [not null, ref: > masters.id]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (client_id, master_id) [pk]
  }
}

Table notifications {
  Note: 'События заявки добавляются триггером notify_booking_change в транзакции изменения статуса.'

  id         uuid         [pk, default: `gen_random_uuid()`]
  user_id    uuid         [not null, ref: > users.id]
  type       varchar(50)  [not null]
  title      varchar(255) [not null]
  message    text
  booking_id uuid         [ref: > bookings.id]
  is_read    boolean      [not null, default: false]
  created_at timestamptz  [not null, default: `now()`]

  indexes {
    (user_id, created_at)
  }
}

// ----------------------------------------------------------------------------- chat

Table conversations {
  id              uuid        [pk, default: `gen_random_uuid()`]
  client_id       uuid        [not null, ref: > users.id]
  master_id       uuid        [not null, ref: > masters.id]
  created_at      timestamptz [not null, default: `now()`]
  last_message_at timestamptz [note: 'для сортировки списка чатов']

  indexes {
    (client_id, master_id) [unique]
    (master_id, last_message_at)
    (client_id, last_message_at)
  }

  Note: 'Личный чат клиента и мастера (как на Kufar). Один диалог на пару; открывается, когда первая запись пары оплачена (CONFIRMED). Деньги здесь не участвуют.'
}

Table messages {
  id                      uuid         [pk, default: `gen_random_uuid()`]
  conversation_id         uuid         [not null, ref: > conversations.id]
  sender_id               uuid         [not null, ref: > users.id]
  text                    text
  attachment_key          varchar(500) [note: 'ключ файла в хранилище; фото отдаётся только участникам']
  attachment_content_type varchar(100)
  attachment_size_bytes   int
  created_at              timestamptz  [not null, default: `now()`]
  read_at                 timestamptz

  indexes {
    (conversation_id, created_at)
  }

  Note: '''
  Текст, фото или и то и другое (одно фото на сообщение).
  CHECK: сообщение не пустое; поля вложения заданы вместе; только image/jpeg, image/png, image/webp;
         размер до 10 МБ; текст до 4000 символов.
  '''
}

// ----------------------------------------------------------------------------- subscriptions (поток №1: MASTER → ЗРОБИМ)

Table subscription_plans {
  id            uuid                   [pk, default: `gen_random_uuid()`]
  code          subscription_plan_code [not null, unique]
  name          varchar(100)           [not null]
  price_monthly decimal(12,2)          [not null, note: 'текущая цена; меняется без миграций']
  is_promoted   boolean                [not null, default: false, note: 'поиск смотрит сюда, а не на code']
  is_active     boolean                [not null, default: true]
  created_at    timestamptz            [not null, default: `now()`]
  updated_at    timestamptz            [not null, default: `now()`]

  Note: 'CHECK: price_monthly > 0.'
}

Table subscription_payments {
  id                  uuid                        [pk, default: `gen_random_uuid()`]
  master_id           uuid                        [not null, ref: > masters.id]
  plan_id             uuid                        [not null, ref: > subscription_plans.id]
  amount              decimal(12,2)               [not null, note: 'snapshot price_monthly']
  currency            char(3)                     [not null, default: 'BYN']
  status              subscription_payment_status [not null, default: 'PENDING']
  provider            varchar(50)                 [not null]
  external_payment_id varchar(255)
  paid_at             timestamptz
  created_at          timestamptz                 [not null, default: `now()`]
  updated_at          timestamptz                 [not null, default: `now()`]

  indexes {
    (provider, external_payment_id) [unique]
    (id, master_id, plan_id) [unique, name: 'subscription_payments_id_master_plan_key', note: 'цель составного FK из master_subscriptions']
    (master_id, created_at)
  }

  Note: 'CHECK: amount > 0; currency ~ ^[A-Z]{3}$; status IN (PAID, REFUNDED) ⇔ paid_at задан.'
}

Table master_subscriptions {
  id                      uuid          [pk, default: `gen_random_uuid()`]
  master_id               uuid          [not null, ref: > masters.id]
  plan_id                 uuid          [not null, ref: > subscription_plans.id]
  subscription_payment_id uuid          [unique, note: 'NULL только для бесплатного trial / выдачи админом']
  price                   decimal(12,2) [not null, note: 'snapshot цены на момент покупки']
  starts_at               timestamptz   [not null]
  expires_at              timestamptz   [not null]
  cancelled_at            timestamptz
  created_at              timestamptz   [not null, default: `now()`]

  indexes {
    (master_id, expires_at)
  }

  Note: '''
  Статуса нет. Активна ⇔ cancelled_at IS NULL AND starts_at <= now() AND expires_at > now().
  Продление и смена тарифа — новая строка; история не удаляется.
  EXCLUDE master_subscriptions_no_overlap USING gist (master_id WITH =, tstzrange(starts_at, expires_at) WITH &&)
    WHERE cancelled_at IS NULL — не больше одного действующего периода.
  CHECK: price >= 0; subscription_payment_id IS NULL ⇔ price = 0; expires_at > starts_at.
  TRIGGER master_subscriptions_require_paid_payment: период по оплате выдаётся только при status = PAID.
  '''
}

Ref master_subscriptions_payment_fk: master_subscriptions.(subscription_payment_id, master_id, plan_id) - subscription_payments.(id, master_id, plan_id)
